# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large corpus and encoded arrays are stored externally via shared-drive links.
/data/raw/
/data/processed/*.txt
/data/encoded/*.bin
*.bin
*.parquet
*.txt.xz
*.tar.gz
*.zip
*.7z

# Ignore generated huge corpus files if placed locally
train.txt
val.txt
test.txt
train.bin
val.bin

# Local model, runtime logs, and archives are reproducible outputs.
/models/tokenizer.json
/logs/
/submission.zip
*.partial
*.tmp

# Python environments
venv/
.venv/
env/
ENV/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and scratch
*.log
scratch/

# Local module walkthroughs
/explanation/
